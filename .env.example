# ==============================================================
# Mộc Silk — Environment Variables
# ==============================================================
# Copy file này thành .env và điền vào thông tin thực tế
# File .env KHÔNG được đẩy lên GitHub (đã có trong .gitignore)

# ============================================================
# TURSO DATABASE (bắt buộc khi deploy)
# Cách lấy:
#   1. Đăng ký miễn phí tại https://app.turso.tech
#   2. Tạo database mới (chọn region gần Việt Nam như "Singapore")
#   3. Vào database → "Connect" → chọn "Turso CLI" hoặc "SDK"
#   4. Copy URL và Auth Token dán vào bên dưới
# ============================================================
TURSO_DATABASE_URL=libsql://ten-database-cua-ban.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ============================================================
# Hướng dẫn deploy lên Render:
#   1. Push code lên GitHub (không có .env, chỉ có .env.example)
#   2. Tạo Web Service trên Render, kết nối GitHub repo
#   3. Build Command: npm run build
#   4. Start Command: npx vite preview  (hoặc node .output/server/index.mjs)
#   5. Vào "Environment" → "Add Environment Variable"
#      → Thêm TURSO_DATABASE_URL và TURSO_AUTH_TOKEN
# ============================================================
